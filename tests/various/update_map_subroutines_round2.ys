proc; opt
miter -equiv -flatten subroutines_round2_gold subroutines_round2_gate subroutines_round2_miter
sat -verify -prove trigger 0 subroutines_round2_miter
miter -equiv -flatten function_struct_chain_round2_gold function_struct_chain_round2_gate function_struct_chain_round2_miter
sat -verify -prove trigger 0 function_struct_chain_round2_miter
