logger -expect log "slang-write-domains begin module=write_domains kind=always_comb" 1
logger -expect log "slang-write-domain static write_domains.c" 1
logger -expect log "slang-write-domain static write_domains.s" 1
logger -expect log "slang-write-domain static write_domains.x" 1
logger -expect log "slang-write-domain static write_domains.y" 1
logger -expect log "slang-write-domain dynamic write_domains.d selected_width=1" 1
logger -expect log "slang-write-domain dynamic write_domains.x selected_width=1" 1
logger -expect log "slang-write-domains end module=write_domains kind=always_comb" 1
logger -expect log "slang-write-domain check matched all_driven" 5
logger -expect log "slang-write-domain check skipped unsupported" 1

read_slang --dump-write-domains <<EOF
typedef struct packed {
  logic [3:0] hi;
  logic [3:0] lo;
} pair_t;

module write_domains (
  input  logic [7:0] a,
  input  logic [7:0] b,
  input  logic [2:0] idx,
  input  logic       en,
  output logic [7:0] x,
  output logic [7:0] y,
  output logic [3:0] c,
  output logic [7:0] d,
  output pair_t      s
);
  always_comb begin
    x = a;
    x[idx] = en;

    if (en)
      y[3:0] = a[3:0];
    else
      y[7:4] = b[7:4];

    {c[3:0], d[idx]} = {a[3:0], en};
    s.lo = a[3:0];
  end
endmodule
EOF

design -reset

logger -expect log "slang-write-domains begin module=view_seed kind=always_comb" 1
logger -expect log "slang-write-domain static view_seed.dst" 1
logger -expect log "slang-write-domain static view_seed.tmp" 1
logger -expect log "slang-write-domain dynamic view_seed.tmp selected_width=1" 1
logger -expect log "slang-write-domains end module=view_seed kind=always_comb" 1

read_slang --dump-write-domains <<EOF
module view_seed (
  input  logic [7:0] base,
  input  logic [2:0] idx,
  input  logic       payload,
  output logic [7:0] dst
);
  logic [7:0] tmp;

  always_comb begin
    tmp = {base[0], base[1], base[2], base[3],
           base[4], base[5], base[6], base[7]};
    tmp[idx] = payload;
    dst = {tmp[0], tmp[1], tmp[2], tmp[3],
           tmp[4], tmp[5], tmp[6], tmp[7]};
  end
endmodule
EOF

design -reset

logger -expect log "slang-write-domains begin module=indexed_ranges kind=always_comb" 1
logger -expect log "slang-write-domain static indexed_ranges.x" 1
logger -expect log "slang-write-domain static indexed_ranges.y" 1
logger -expect log "slang-write-domain dynamic indexed_ranges.r selected_width=2" 1
logger -expect log "slang-write-domain dynamic indexed_ranges.z selected_width=2" 1
logger -expect log "slang-write-domains end module=indexed_ranges kind=always_comb" 1

read_slang --dump-write-domains <<EOF
module indexed_ranges (
  input  logic [7:0] a,
  input  logic [2:0] idx,
  output logic [7:0] x,
  output logic [7:0] y,
  output logic [7:0] z,
  output logic [7:0] r
);
  always_comb begin
    x[2 +: 3] = a[2:0];
    y[5 -: 3] = a[2:0];
    z[idx +: 2] = a[1:0];
    r[idx -: 2] = a[1:0];
  end
endmodule
EOF

design -reset

logger -expect log "slang-write-domains begin module=reversed_ranges kind=always_comb" 1
logger -expect log "slang-write-domain static reversed_ranges.x" 1
logger -expect log "slang-write-domain dynamic reversed_ranges.x selected_width=1" 1
logger -expect log "slang-write-domains end module=reversed_ranges kind=always_comb" 1

read_slang --dump-write-domains <<EOF
module reversed_ranges (
  input  logic [0:7] a,
  input  logic [2:0] idx,
  input  logic       bit_i,
  output logic [0:7] x
);
  always_comb begin
    x[1 +: 3] = a[1 +: 3];
    x[idx] = bit_i;
  end
endmodule
EOF

design -reset

logger -expect log "slang-write-domains begin module=multi_dynamic kind=always_comb" 1
logger -expect log "slang-write-domain dynamic multi_dynamic.a selected_width=16" 1
logger -expect log "slang-write-domain dynamic multi_dynamic.b.*selected_width=8" 1
logger -expect log "slang-write-domains end module=multi_dynamic kind=always_comb" 1

read_slang --dump-write-domains <<EOF
module multi_dynamic (
  input  logic [1:0] idx,
  input  logic [1:0][7:0] pair_i,
  input  logic [7:0] lane_i,
  output logic [3:0][1:0][7:0] a,
  output logic [1:0][3:0][7:0] b
);
  always_comb begin
    a[idx] = pair_i;
    b[1][idx] = lane_i;
  end
endmodule
EOF

design -reset

logger -expect log "slang-write-domains begin module=unsupported_domains kind=always_comb" 1
logger -expect log "slang-write-domain unsupported memory write" 1
logger -expect log "slang-write-domain unsupported nested dynamic lhs" 1
logger -expect log "slang-write-domain unsupported non-fixed-size lhs" 1
logger -expect log "slang-write-domains end module=unsupported_domains kind=always_comb" 1

read_slang --dump-write-domains <<EOF
module unsupported_domains (
  input  logic [1:0] i,
  input  logic [1:0] j,
  input  logic [7:0] data_i,
  output logic [7:0] x
);
  logic [7:0] mem [0:3];
  logic [3:0][3:0] nested;

  always_comb begin
    mem[i] = data_i;
    {<<{x}} = data_i;
    nested[i][j] = 1'b1;
  end
endmodule
EOF
