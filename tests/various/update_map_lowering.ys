# Dead-write elimination: a full overwrite drops the earlier pending write
# entirely; the flush of an unconditional final value needs no mux cells.
read_slang --use-update-map-lowering <<EOF2
module deadwrite_gate (
  input  logic [7:0] a_i, b_i,
  output logic [7:0] y
);
  always_comb begin
    y = a_i ^ 8'h5a;
    y = b_i;
  end
endmodule
EOF2

