    view_a = old_i;
    view_b = old_i;
    base = old_i;
    for (int n = 0; n < 2; n++) begin
      for (int p = 0; p < 2; p++) begin
        for (int q = 0; q < 2; q++) begin
          if (sel_i)
            view_a[idx_i[n]][q][n][p] = data_i[n][p][q];
          else
            view_b[idx_i[n]][q][n][p] = ~data_i[n][p][q];
        end
      end
    end
    base = sel_i ? view_a : view_b;
    y_o = base;
  end
endmodule
EOF

proc; opt; scc -expect 0
miter -equiv -flatten nested_guarded_inner_gold nested_guarded_inner_gate nested_guarded_inner_miter
sat -verify -prove trigger 0 nested_guarded_inner_miter

