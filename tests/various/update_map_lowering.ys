# Parallel case behind an unconditional default write: the default flushes
# as the plain word value and the disjoint items still fold into one $pmux
# selecting over it, with no residual word-mux chain.
read_slang <<EOF2
module parbase_gold (
  input  logic [1:0] sel_i,
  input  logic [7:0] a_i, b_i, c_i,
  output logic [7:0] y
);
  always_comb begin
    y = 8'h5a;
    case (sel_i)
      2'd0: y = a_i;
      2'd1: y = b_i;
      2'd2: y = c_i;
    endcase
  end
endmodule
EOF2

