read_slang <<EOF
module lowering_gold (
  input  logic [7:0] data_i,
  input  logic [7:0] old_i,
  input  logic [2:0] idx_i,
  input  logic       en_i,
  output logic [7:0] x,
  output logic [7:0] y,
  output logic [7:0] z
);
  always_comb begin
    x = old_i;
    y = 8'h00;
    z = old_i;

    x[3:0] = data_i[3:0];

    if (en_i)
      y[7:4] = data_i[7:4];
    else
      y[3:0] = data_i[3:0];

    z[idx_i] = data_i[0];
  end
endmodule
EOF

