module guarded_view_commit_gold (
  input  logic [1:0][1:0] idx_i,
  input  logic [1:0][1:0][7:0] data_i,
  input  logic sel_i,
  input  logic [1:0][3:0][1:0][7:0] old_i,
  output logic [1:0][3:0][1:0][7:0] y_o
);
  logic [1:0][3:0][1:0][7:0] view_a;
  logic [1:0][3:0][1:0][7:0] view_b;
  logic [1:0][3:0][1:0][7:0] base;

  always_comb begin
    view_a = old_i;
    view_b = old_i;
    base = old_i;
    for (int n = 0; n < 2; n++) begin
      for (int q = 0; q < 2; q++) begin
        view_a[n][idx_i[n]][q] = data_i[n][q];
        view_b[n][idx_i[n]][q] = ~data_i[n][q];
      end
    end
    if (sel_i)
      base = view_a;
    else
      base = view_b;
    y_o = base;
  end
endmodule
EOF

