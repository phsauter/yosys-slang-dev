# Regression: a static write after a dynamic write to the same variable must
# not coalesce backwards past the dynamic write (write order must hold).
read_slang <<EOF2
module order_gold (
  input  logic [7:0] a_i,
  input  logic [7:0] c_i,
  input  logic       b_i,
  input  logic [2:0] idx_i,
  output logic [7:0] v
);
  always_comb begin
    v = 8'h00;
    v[3:0] = a_i[3:0];
    v[idx_i] = b_i;
    v[3:0] = c_i[3:0];
  end
endmodule
EOF2

