# Parallel case: disjoint constant items must not produce a priority ladder
# (at most the default keeps one inversion), and must stay equivalent.
read_slang <<EOF2
module parcase_gold (
  input  logic [1:0] sel_i,
  input  logic [7:0] a_i, b_i, c_i,
  output logic [7:0] y
);
  always_comb begin
    case (sel_i)
      2'd0: y = a_i;
      2'd1: y = b_i;
      2'd2: y = c_i;
      default: y = 8'h00;
    endcase
  end
endmodule
EOF2

proc; opt

read_slang --use-update-map-lowering <<EOF2
module parcase_gate (
  input  logic [1:0] sel_i,
  input  logic [7:0] a_i, b_i, c_i,
  output logic [7:0] y
);
  always_comb begin
    case (sel_i)
      2'd0: y = a_i;
      2'd1: y = b_i;
      2'd2: y = c_i;
      default: y = 8'h00;
    endcase
  end
endmodule
EOF2

select -module parcase_gate
# Disjoint constant items need no priority ladder: no guard ANDing at all,
# and at most the zero-compare canonicalization plus the default-guard
# inversion may appear as $logic_not. The disjoint writes fold into one
# flat $pmux instead of a word-mux chain.
select -assert-none t:$logic_and
select -assert-max 2 t:$logic_not
select -assert-count 1 t:$pmux
select -assert-none t:$mux
select -clear

proc; opt
miter -equiv -flatten parcase_gold parcase_gate parcase_miter
sat -verify -prove trigger 0 parcase_miter

