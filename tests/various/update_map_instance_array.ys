read_slang --top instance_array_gold <<SV
module instance_array_leaf_gold #(
  parameter logic [7:0] MASK = '0
) (
  input  logic [7:0] data_i,
  input  logic       select_i,
  output logic [7:0] data_o
);
  always_comb begin
    data_o = data_i;
    if (select_i)
      data_o[5:2] = data_i[3:0] ^ MASK[3:0];
  end
endmodule

module instance_array_gold (
  input  logic [1:0][7:0] data_i,
  input  logic [1:0]      select_i,
  output logic [1:0][7:0] data_o
);
  instance_array_leaf_gold #(.MASK(8'h3c)) leaves[1:0] (
    .data_i(data_i),
    .select_i(select_i),
    .data_o(data_o)
  );
endmodule
SV

proc; opt

read_slang --top instance_array_gate --use-update-map-lowering <<SV
module instance_array_leaf_gate #(
  parameter logic [7:0] MASK = '0
) (
  input  logic [7:0] data_i,
  input  logic       select_i,
  output logic [7:0] data_o
);
  always_comb begin
    data_o = data_i;
    if (select_i)
      data_o[5:2] = data_i[3:0] ^ MASK[3:0];
  end
endmodule

module instance_array_gate (
  input  logic [1:0][7:0] data_i,
  input  logic [1:0]      select_i,
  output logic [1:0][7:0] data_o
);
  instance_array_leaf_gate #(.MASK(8'h3c)) leaves[1:0] (
    .data_i(data_i),
    .select_i(select_i),
    .data_o(data_o)
  );
endmodule
SV

proc; opt
miter -equiv -flatten instance_array_gold instance_array_gate instance_array_miter
sat -verify -prove trigger 0 instance_array_miter
